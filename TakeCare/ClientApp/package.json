{
  "name": "takecare-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "prettier-verify": "prettier ./src --check --config ./.prettierrc.json",
    "debug": "vite --debug",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bootstrap": "^5.3.3",
    "html2pdf.js": "0.14.0",
    "pinia": "^2.1.7",
    "sweetalert2": "^11.6.13",
    "vee-validate": "^4.12.7",
    "vue": "^3.4.26",
    "vue-axios": "^3.5.2",
    "vue-router": "^4.3.2",
    "vuex": "^4.1.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.2",
    "@types/bootstrap": "^5.2.10",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.2.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vite-plugin-mkcert": "^1.17.5",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.3"
    },
    "js-beautify": {
      "glob": "^14.0.3"
    }
  }
}
